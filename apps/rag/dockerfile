FROM node:26-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/main/package.json ./apps/main/
COPY apps/file-process/package.json ./apps/file-process/
COPY apps/rag/package.json ./apps/rag/
COPY packages/shared/logger/package.json ./packages/shared/logger/
COPY packages/shared/rabbitmq/package.json ./packages/shared/rabbitmq/
COPY packages/shared/firebase/package.json ./packages/shared/firebase/
COPY packages/shared/file-storage/package.json ./packages/shared/file-storage/
COPY packages/shared/qdrant/package.json ./packages/shared/qdrant/
COPY packages/contracts/file-process/package.json ./packages/contracts/file-process/
COPY packages/contracts/rag/package.json ./packages/contracts/rag/
COPY configs ./configs

RUN npm ci

COPY . .

RUN npm run build --workspace=@vention/shared-logger && npm run build --workspace=@vention/shared-firebase && npm run build --workspace=@vention/shared-rabbitmq && npm run build --workspace=@vention/shared-file-storage && npm run build --workspace=@vention/shared-qdrant && npm run build --workspace=@vention/rag-contract
RUN npm run build --workspace=@vention/rag && test -f apps/rag/dist/main.js

FROM node:26-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/rag/package.json ./apps/rag/
COPY --from=builder /app/apps/rag/dist ./apps/rag/dist

WORKDIR /app/apps/rag

CMD ["node", "dist/main.js"]

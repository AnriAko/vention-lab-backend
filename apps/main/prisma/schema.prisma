generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
    runtime      = "nodejs"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(uuid())
    email     String   @unique
    name      String
    password  String

    image String @default("")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizations     UsersOrganizations[]
    organizationRoles UsersOrganizationsRoles[]
    owner             Owner?
    files             File[]
    chats             UsersChats[]
    messages          Message[]

    aiConversations   AiConversation[]

    @@unique([createdAt, id])
}

model Owner {
    userId    String   @id
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
    id        String   @id @default(uuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isDeleted Boolean  @default(false)

    users     UsersOrganizations[]
    userRoles UsersOrganizationsRoles[]
    chats     Chat[]
    files     File[]
}

model UsersOrganizations {
    userId         String
    organizationId String
    isDeleted      Boolean   @default(false)
    deletedAt      DateTime?
    moneySpent     Decimal   @default(0) @db.Decimal(19, 4)

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@id([userId, organizationId])
    @@index([organizationId])
    @@index([organizationId, isDeleted])
}

model UsersOrganizationsRoles {
    userId         String
    organizationId String
    role           OrganizationRole @default(USER)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    @@id([userId, organizationId])
    @@index([organizationId])
}

model File {
    id             String   @id @default(uuid())
    ownerId        String
    organizationId String

    owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    name            String
    size            Int
    status          FileStatus @default(UPLOADED)
    contentType     String
    checksum        String     @default("")
    storageKey      String
    processingError String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([organizationId])
}

model Chat {
    id             String       @id @default(uuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    users    UsersChats[]
    messages Message[]

    @@index([organizationId])
}

model UsersChats {
    userId String
    chatId String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

    @@id([userId, chatId])
    @@index([chatId])
}

model Message {
    id        String   @id @default(uuid())
    chatId    String
    senderId  String
    content   String
    createdAt DateTime @default(now())

    chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
    sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
    @@index([chatId])
    @@index([senderId])
}
model AiConversation {
    id        String   @id @default(uuid())
    userId    String
    title     String   @default("New conversation")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages AiConversationMessage[]

    @@index([userId, updatedAt])
}

model AiConversationMessage {
    id             String                @id @default(uuid())
    conversationId String
    role           AiConversationMessageRole
    status         AiConversationMessageStatus?
    content        String

    createdAt DateTime @default(now())

    conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
	@@map("AiConversationMessage")
}

enum AiConversationMessageRole {
    USER
    ASSISTANT
    SYSTEM
}

enum AiConversationMessageStatus {
    SUCCESS
    CANCELLED
    FAILED
}

enum OrganizationRole {
    USER
    ADMIN
}

enum FileStatus {
    UPLOADED
    PROCESSING
    COMPLETED
    FAILED
}
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

FIREBASE_PROJECT_ID=vention-lab
FIREBASE_STORAGE_BUCKET=vention-lab.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-service-account.json

QDRANT_URL=http://localhost:6333
# Only required in production
# QDRANT_API_KEY=your-very-long-random-secret

CHUNKING_STRATEGY=markdown
CHUNKING_MAX_CHUNK_SIZE=1000
CHUNKING_OVERLAP=150

EMBEDDING_BATCH_SIZE=32

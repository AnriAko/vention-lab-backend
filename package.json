{
    "name": "vention-lab-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "cross-env NODE_ENV=production nest build",
        "start": "cross-env NODE_ENV=production nest start",
        "dev": "cross-env NODE_ENV=development nest start --watch",
        "debug": "cross-env NODE_ENV=development nest start --debug --watch",
        "prod": "cross-env NODE_ENV=production node dist/main",
        "docker:build": "docker build -t vention-api .",
        "docker:build:clean": "docker build --no-cache -t vention-api .",
        "docker:dev": "docker compose -f compose.dev.yml up --build",
        "docker:prod": "docker compose -f compose.prod.yml up -d --build",
        "docker:dev:down": "docker compose -f compose.dev.yml down",
        "docker:prod:down": "docker compose -f compose.prod.yml down",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "format": "prettier --write .",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.4.4",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "cross-env": "^10.1.0",
        "nest-zod": "^1.0.0",
        "nestjs-zod": "^5.4.0",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.2",
        "@types/supertest": "^7.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "lint-staged": "^17.0.7",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.6.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}

{
    "name": "vention-lab-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "cross-env NODE_ENV=production nest build",
        "start": "cross-env NODE_ENV=production nest start",
        "dev": "cross-env NODE_ENV=development nest start --watch",
        "debug": "cross-env NODE_ENV=development nest start --debug --watch",
        "prod": "cross-env NODE_ENV=production node dist/src/main",
        "docker:build": "docker build -t vention-api .",
        "docker:build:clean": "docker build --no-cache -t vention-api .",
        "docker:build:worker": "docker build -f microservices/file-process/dockerfile -t vention-file-process .",
        "worker:dev": "npm run start:dev --prefix microservices/file-process",
        "worker:docker:up": "npm run docker:up --prefix microservices/file-process",
        "shared:sync": "tsx scripts/microservices/sync-shared.ts",
        "docker:dev": "docker compose -f compose.dev.yml up -d",
        "docker:dev:tools": "docker compose -f compose.dev.yml --profile tools up -d",
        "docker:dev:av": "docker compose -f compose.dev.yml --profile antivirus up -d",
        "docker:dev:all": "docker compose -f compose.dev.yml --profile tools --profile antivirus up -d",
        "docker:prod": "docker compose -f compose.prod.yml up -d --build",
        "docker:dev:down": "docker compose -f compose.dev.yml --profile tools --profile antivirus down",
        "docker:prod:down": "docker compose -f compose.prod.yml down",
        "prisma:seed": "cross-env NODE_ENV=development prisma db seed --config src/config/prisma/prisma.config.ts",
        "prisma:clean": "cross-env NODE_ENV=development tsx prisma/clean.ts",
        "prisma:seed:fresh": "npm run prisma:clean && npm run prisma:seed",
        "prisma:generate": "prisma generate --config src/config/prisma/prisma.config.ts",
        "prisma:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev --config src/config/prisma/prisma.config.ts",
        "prisma:migrate:deploy": "cross-env NODE_ENV=production prisma migrate deploy --config src/config/prisma/prisma.config.ts",
        "prisma:studio": "cross-env NODE_ENV=development prisma studio --config src/config/prisma/prisma.config.ts",
        "prisma:reset": "cross-env NODE_ENV=development prisma migrate reset --config src/config/prisma/prisma.config.ts",
        "prisma:push": "cross-env NODE_ENV=development prisma db push --config src/config/prisma/prisma.config.ts",
        "prisma:db:explain": "tsx prisma/scripts/explain/explain.ts",
        "prisma:db:execute": "tsx prisma/scripts/execute/execute.ts",
        "excel:generate": "cross-env NODE_ENV=development tsx scripts/generate-excel-data.ts",
        "format": "prettier --write .",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@nestjs/apollo": "^13.4.5",
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.27",
        "@nestjs/graphql": "^13.4.5",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "*",
        "@nestjs/microservices": "^11.1.28",
        "@nestjs/platform-express": "^11.1.27",
        "@nestjs/platform-socket.io": "^11.1.29",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.1.29",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^2.0.1",
        "argon2": "^0.44.0",
        "chalk": "^5.6.2",
        "clamscan": "^2.4.0",
        "cookie-parser": "^1.4.7",
        "cross-env": "^10.1.0",
        "exceljs": "^4.4.0",
        "firebase-admin": "^14.2.0",
        "graphql": "^16.14.2",
        "helmet": "^8.3.0",
        "ioredis": "^5.11.1",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@faker-js/faker": "^10.5.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/swagger": "^11.4.4",
        "@nestjs/testing": "^11.1.27",
        "@types/amqplib": "^0.10.8",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.13.3",
        "@types/supertest": "^7.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.7",
        "nestjs-zod": "^5.4.0",
        "prettier": "^3.4.2",
        "prisma": "^7.10.0",
        "source-map-support": "^0.5.21",
        "sql-formatter": "^15.8.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.4.11",
        "ts-loader": "^9.6.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0"
    },
    "allowScripts": {
        "@scarf/scarf@1.4.0": true,
        "unrs-resolver@1.12.2": true,
        "@firebase/util@1.15.1": true,
        "@prisma/engines@7.9.1": true,
        "argon2@0.44.0": true,
        "esbuild@0.28.1": true,
        "prisma@7.9.1": true,
        "protobufjs@7.6.5": true
    },
    "overrides": {
        "js-yaml": "^4.2.0",
        "multer": "^1.4.5-lts.1"
    }
}

{
    "name": "vention-lab-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "cross-env NODE_ENV=production nest build",
        "start": "cross-env NODE_ENV=production nest start",
        "dev": "cross-env NODE_ENV=development nest start --watch",
        "debug": "cross-env NODE_ENV=development nest start --debug --watch",
        "prod": "cross-env NODE_ENV=production node dist/main",
        "docker:build": "docker build -t vention-api .",
        "docker:build:clean": "docker build --no-cache -t vention-api .",
        "docker:dev": "docker compose -f compose.dev.yml up -d --build",
        "docker:prod": "docker compose -f compose.prod.yml up -d --build",
        "docker:dev:down": "docker compose -f compose.dev.yml down",
        "docker:prod:down": "docker compose -f compose.prod.yml down",
        "prisma:seed": "prisma db seed --config src/config/prisma/prisma.config.ts",
        "prisma:generate": "prisma generate --config src/config/prisma/prisma.config.ts",
        "prisma:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev --config src/config/prisma/prisma.config.ts",
        "prisma:migrate:deploy": "cross-env NODE_ENV=production prisma migrate deploy --config src/config/prisma/prisma.config.ts",
        "prisma:studio": "cross-env NODE_ENV=development prisma studio --config src/config/prisma/prisma.config.ts",
        "prisma:reset": "cross-env NODE_ENV=development prisma migrate reset --config src/config/prisma/prisma.config.ts",
        "prisma:push": "cross-env NODE_ENV=development prisma db push --config src/config/prisma/prisma.config.ts",
        "format": "prettier --write .",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.27",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.27",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.1.27",
        "@nestjs/terminus": "^11.1.1",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "amqp-connection-manager": "^5.0.0",
        "amqplib": "^2.0.1",
        "argon2": "^0.44.0",
        "cookie-parser": "^1.4.7",
        "cross-env": "^10.1.0",
        "ioredis": "^5.11.1",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@faker-js/faker": "^10.5.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/swagger": "^11.4.4",
        "@nestjs/testing": "^11.1.27",
        "@types/amqplib": "^0.10.8",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.2",
        "@types/supertest": "^7.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.7",
        "nest-zod": "^1.0.0",
        "nestjs-zod": "^5.4.0",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.4.11",
        "ts-loader": "^9.6.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0"
    },
    "allowScripts": {
        "@prisma/engines@7.8.0": true,
        "@scarf/scarf@1.4.0": true,
        "prisma@7.8.0": true,
        "unrs-resolver@1.12.2": true
    },
    "overrides": {
        "js-yaml": "^4.2.0",
        "multer": "^1.4.5-lts.1"
    }
}

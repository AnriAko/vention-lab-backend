PORT=3000

# or localhost instead of db
DATABASE_URL=postgresql://postgres:postgres@db:5432/app_db

# Redis
# or localhost
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
# or localhost
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# for local development env
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT setup
JWT_SECRET=super_secret_key

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Argon2 password hashing (2^16)
ARGON2_PASSWORD_MEMORY_COST=65536
ARGON2_PASSWORD_TIME_COST=3
ARGON2_PASSWORD_PARALLELISM=1

# Argon2 token hashing (2^14)
ARGON2_TOKEN_MEMORY_COST=16384
ARGON2_TOKEN_TIME_COST=2
ARGON2_TOKEN_PARALLELISM=1

# Firebase Storage
FIREBASE_PROJECT_ID=vention-lab
FIREBASE_STORAGE_BUCKET=vention-lab.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=./credentials/firebase-service-account.json

# ClamAV
# Local tip: set CLAMAV_ENABLED=false and omit the antivirus compose profile to save ~2GB RAM.
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# Qdrant
QDRANT_URL=http://vector-db:6333
# Only in production
QDRANT_API_KEY=your-very-long-random-secret

# Chunking
CHUNKING_STRATEGY=markdown
CHUNKING_MAX_CHUNK_SIZE=1000
CHUNKING_OVERLAP=150

# Ollama
# If rag runs inside Docker, use the host address reachable from the container.
# For Ollama running on the host machine, see note below.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_BATCH_SIZE=32
OLLAMA_GENERATION_MODEL=qwen3:0.6b

RAG_WS_URL=http://localhost:3002